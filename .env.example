# Copy to .env.local for development. Never commit real values.

# ─── Database (Neon PostgreSQL) ───────────────────────────
# Pooled connection (runtime queries – PgBouncer, port 5432)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct/unpooled connection (migrations & DDL only)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-XXXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Max connections per serverless instance (keep low on Vercel)
DB_POOL_MAX=3

# ─── Supabase Auth (admin magic-link login) ───────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ─── Cloudflare Turnstile (bot protection) ────────────────
# Always-pass TEST keys for local development; replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Session / Security ──────────────────────────────────
# Random 32+ character string; signs the short-lived search cookie & salts IP hashes
SESSION_SECRET=

# ─── App Config ───────────────────────────────────────────
CONSENT_VERSION=2026-10-v1
# IMPORTANT: set to your Vercel production URL in Vercel env vars!
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Rate Limiting (per-IP requests per minute) ──────────
# Raise on meet day if people on shared mobile IPs see "Too many requests"
RATE_LIMIT_IDENTITY=10
RATE_LIMIT_SEARCH=10
RATE_LIMIT_REGISTER=10

# ─── Development Shortcuts ───────────────────────────────
# Skip magic-link; treat this email as signed-in admin (NODE_ENV=development only)
DEV_ADMIN_EMAIL=

# ─── Future Services (M7+) ───────────────────────────────
RESEND_API_KEY=
SMS_API_KEY=
